# Herald needs to run a handful of specific, non-interactive commands as
# root. This rule is scoped to exactly those command lines - do NOT widen
# it to blanket NOPASSWD access to nginx/systemctl, which would let a
# compromised herald process do far more than these three things.
#
# Writing whitelist.conf itself does NOT go through sudo - see
# ../nginx-whitelist-markers.md for the group-write setup that lets the
# herald user edit that one file directly. sudo is only for the two steps
# that need root: validating the result and making it live.
#
# Install as /etc/sudoers.d/herald (mode 0440, owned by root), and always
# validate with `visudo -cf /etc/sudoers.d/herald` before/after editing -
# a broken sudoers file can lock out sudo entirely.

herald ALL=(root) NOPASSWD: \
    /usr/sbin/nginx -t, \
    /usr/bin/systemctl reload nginx, \
    /usr/bin/systemctl restart blog
