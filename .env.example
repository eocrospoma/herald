# Copy to /etc/herald/herald.env (referenced by deploy/herald.service),
# fill in real values, and lock it down - it holds the TOTP secret.
#   chmod 640 /etc/herald/herald.env
#   chown root:herald /etc/herald/herald.env

# Shared secret for HOTP/TOTP (RFC 4226/6238). Generate one with:
#   openssl rand -base64 32
# Seed the SAME value into your authenticator app (as a raw/base32 secret,
# matching whatever import format it expects) so its codes match Herald's.
HERALD_TOTP_SECRET=

# Address Herald's HTTP server binds to. Loopback-only by default - it's
# reverse-proxied by host-nginx and never exposed directly to the internet.
HERALD_LISTEN_ADDR=127.0.0.1:8420

# Where the JSON-Lines audit log is appended. Must be writable by the
# herald user; matches deploy/herald.service's ReadWritePaths and
# deploy/fail2ban/jail.local.example's logpath.
HERALD_AUDIT_LOG_PATH=/var/log/herald/audit.jsonl
